# Local PostgreSQL. Docker Compose replaces the host with `postgres` internally.
POSTGRES_USER=football
POSTGRES_PASSWORD=football
POSTGRES_DB=football
POSTGRES_PORT=5432
DATABASE_URL=postgresql://football:football@localhost:5432/football?schema=public
TEST_DATABASE_URL=postgresql://football:football@localhost:5432/football_test?schema=public

# pgAdmin UI for the full Docker stack at http://localhost:5050
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@football-bets.example.com
PGADMIN_DEFAULT_PASSWORD=replace-this-with-a-strong-pgadmin-password

# Local Redis. Docker Compose replaces the host with `redis` internally.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Application and secure server-managed sessions
PORT=3000
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
APP_PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
APP_TZ=Europe/Madrid
TOPUP_AMOUNT=200
INITIAL_COIN_BALANCE=1000
DEV_TOOLS=true
WORKER_CONCURRENCY=5

# Email delivery. For Gmail, use the account address and a dedicated Google app
# password. Never commit real credentials. EMAIL_PASSWORD may be written with or
# without the spaces shown by Google.
EMAIL_NAME=your-account@gmail.com
EMAIL_PASSWORD=replace-with-a-new-app-password

# Optional generic SMTP overrides. When these are set they take precedence over
# the Gmail-friendly EMAIL_NAME and EMAIL_PASSWORD variables above.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
